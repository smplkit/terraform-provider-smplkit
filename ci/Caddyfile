# Reverse proxy for the acceptance-test platform
#
# Routes *.localhost subdomains to the matching docker-compose service.
# Differs from the dev Caddyfile (in private smplkit/.github at
# platform/Caddyfile) in that every upstream is a compose service
# name (`app:8000`, `audit:8000`) rather than
# `host.docker.internal:NNNN` — the dev file points at the host
# because app + audit run natively there for live-reload, while CI
# runs everything in compose for reproducibility.

http://app.localhost {
	reverse_proxy app:8000
}

http://config.localhost {
	reverse_proxy config:8000
}

http://flags.localhost {
	reverse_proxy flags:8000
}

http://logging.localhost {
	reverse_proxy logging:8000
}

http://audit.localhost {
	reverse_proxy audit:8000
}
